FROM wordpress:7.1.3-php8.3-apache@sha256:81a34254acaa6ff3b9a67268c2745e9a041c4094cbe5ccd35b75ed3bbdc033b5

# Keep the PHP/Apache runtime fixed and replace only the bundled WordPress core.
ADD --checksum=sha256:be5fdce1adebb81526e7f2219c1833cb12add48202970b6d7b048a44518f98f2 https://wordpress.org/wordpress-7.2-beta1.tar.gz /tmp/wordpress-beta.tar.gz
RUN mv /usr/src/wordpress/wp-config-docker.php /tmp/wp-config-docker.php \
    && rm -rf /usr/src/wordpress \
    && mkdir /usr/src/wordpress \
    && tar -xzf /tmp/wordpress-beta.tar.gz -C /usr/src/wordpress --strip-components=1 \
    && rm /tmp/wordpress-beta.tar.gz \
    && mv /tmp/wp-config-docker.php /usr/src/wordpress/wp-config-docker.php \
    && php -r 'require "/usr/src/wordpress/wp-includes/version.php"; if ($wp_version !== "7.2-beta1") { exit(1); }' \
    && chown -R www-data:www-data /usr/src/wordpress
